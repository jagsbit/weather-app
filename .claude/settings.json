{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_push.py\"",
            "timeout": 10,
            "statusMessage": "Checking git push..."
          }
        ]
      }
    ]
  }
}
